---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'projects', text: '项目' },
  { depth: 2, slug: 'sponsorship', text: '赞助' }
]
---

<PageLayout title='项目' {headings} info={{ slug: '/projects', hideComment: true }}>
  <h2 id='projects' class='mb-8 text-2xl font-semibold'>Projects</h2>
  <ProjectSection project={[]} />
  <p class='text-muted-foreground'>项目展示区,敬请期待。</p>

  <!-- sponsorship -->
  <h2 id='sponsorship'>赞助</h2>
  <p>感谢支持!赞助二维码与名单将在后续添加。</p>
</PageLayout>